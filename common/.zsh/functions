# Smart nvim opener
n() { [[ $# -eq 0 ]] && nvim . || nvim "$@"; }

# Auto-activate python venv on directory change
# add-zsh-hook autoloaded here because this file is sourced before starship init
autoload -Uz add-zsh-hook

_venv_auto() {
  local d=$PWD found=""
  while [[ -n $d ]]; do
    [[ -f $d/.venv/bin/activate ]] && { found=$d/.venv; break; }
    [[ -f $d/venv/bin/activate ]]  && { found=$d/venv;  break; }
    d=${d%/*}
  done

  if [[ -n $found ]]; then
    [[ $VIRTUAL_ENV == $found ]] && return
    VIRTUAL_ENV_DISABLE_PROMPT=1 source $found/bin/activate
    _VENV_AUTO=1
  elif [[ -n $VIRTUAL_ENV && -n $_VENV_AUTO ]] && (( $+functions[deactivate] )); then
    deactivate
    unset _VENV_AUTO
  fi
}

add-zsh-hook chpwd _venv_auto
_venv_auto

# Smart cd via zoxide
if command -v zoxide &>/dev/null; then
  zd() {
    if [[ $# -eq 0 ]]; then
      builtin cd ~
    elif [[ -d "$1" ]]; then
      builtin cd "$1"
    else
      z "$@" && printf "\U000F17A9 " && pwd
    fi
  }
  alias cd="zd"
fi

# WSL: pick a project and open it in VSCode. Launching from inside WSL is what
# guarantees a Remote-WSL window — opening the same folder from a Windows
# window yields a local one and the "Reopen in WSL" prompt.
if [[ -n "$WSL_DISTRO_NAME" ]] && command -v fzf &>/dev/null; then
  p() {
    local root=${PROJECTS_DIR:-$HOME/projects} d
    # Repo roots, not directories — projects sit at mixed depths under $root.
    # -prune stops the descent at each .git so nested checkouts stay cheap.
    # fd is not used here: it skips .git even with -H.
    d=$(find "$root" -maxdepth 4 -type d -name .git -prune -printf '%h\n' 2>/dev/null \
        | sed "s|^$root/||" | sort | fzf --prompt='project> ') || return
    [[ -z $d ]] && return
    builtin cd "$root/$d" && code .
  }
fi

# Compression
compress() { tar -czf "${1%/}.tar.gz" "${1%/}"; }

# Media transcoding
transcode-video-1080p() {
  ffmpeg -i "$1" -vf scale=1920:1080 -c:v libx264 -preset fast -crf 23 -c:a copy "${1%.*}-1080p.mp4"
}

transcode-video-4K() {
  ffmpeg -i "$1" -c:v libx265 -preset slow -crf 24 -c:a aac -b:a 192k "${1%.*}-optimized.mp4"
}

# Image conversion
img2jpg() {
  local img="$1"; shift
  magick "$img" "$@" -quality 95 -strip "${img%.*}-optimized.jpg"
}

img2jpg-small() {
  local img="$1"; shift
  magick "$img" "$@" -resize 1080x\> -quality 95 -strip "${img%.*}-optimized.jpg"
}

img2png() {
  local img="$1"; shift
  magick "$img" "$@" -strip \
    -define png:compression-filter=5 \
    -define png:compression-level=9 \
    -define png:compression-strategy=1 \
    -define png:exclude-chunk=all \
    "${img%.*}-optimized.png"
}

# Linux-only
if [[ "$(uname)" == "Linux" ]]; then
  open() { xdg-open "$@" >/dev/null 2>&1 & }

  iso2sd() {
    if [[ $# -ne 2 ]]; then
      echo "Usage: iso2sd <input_file> <output_device>"
      echo "Example: iso2sd ~/Downloads/ubuntu.iso /dev/sda"
      echo -e "\nAvailable SD cards:"
      lsblk -d -o NAME | grep -E '^sd[a-z]' | awk '{print "/dev/"$1}'
    else
      sudo dd bs=4M status=progress oflag=sync if="$1" of="$2"
      sudo eject "$2"
    fi
  }

  format-drive() {
    if [[ $# -ne 2 ]]; then
      echo "Usage: format-drive <device> <name>"
      echo "Example: format-drive /dev/sda 'My Stuff'"
      echo -e "\nAvailable drives:"
      lsblk -d -o NAME -n | awk '{print "/dev/"$1}'
    else
      echo "WARNING: This will completely erase all data on $1 and label it '$2'."
      read -rp "Are you sure you want to continue? (y/N): " confirm
      if [[ "$confirm" =~ ^[Yy]$ ]]; then
        sudo wipefs -a "$1"
        sudo dd if=/dev/zero of="$1" bs=1M count=100 status=progress
        sudo parted -s "$1" mklabel gpt
        sudo parted -s "$1" mkpart primary 1MiB 100%
        local partition
        partition="$([[ $1 == *nvme* ]] && echo "${1}p1" || echo "${1}1")"
        sudo partprobe "$1" || true
        sudo udevadm settle || true
        sudo mkfs.exfat -n "$2" "$partition"
        echo "Drive $1 formatted as exFAT and labeled '$2'."
      fi
    fi
  }
fi
