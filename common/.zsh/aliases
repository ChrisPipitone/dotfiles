# Editor
alias vim='nvim'

# File system
if command -v lsd &>/dev/null; then
  alias ls='lsd'
  alias la='lsd -la'
  alias ll='lsd -lA'
  alias lt='lsd --tree'
  alias lsa='lsd -a'
  alias lta='lsd --tree -a'
elif command -v colorls &>/dev/null; then
  alias ls='colorls'
  alias la='colorls -la'
  alias ll='colorls -l'
fi

if command -v bat &>/dev/null; then
  alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
elif command -v batcat &>/dev/null; then
  alias ff="fzf --preview 'batcat --style=numbers --color=always {}'"
else
  alias ff="fzf --preview 'cat {}'"
fi

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias c='clear'
alias config='cd ~/.config && nvim'
alias decompress='tar -xzf'

# Git
alias g='git'
alias gs='git status'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'
alias gitwin='"/mnt/c/Program Files/Git/cmd/git.exe"'

# Linux-only
if [[ "$(uname)" == "Linux" ]]; then
  alias rnote="GDK_DEBUG=no-vsync rnote"
fi
