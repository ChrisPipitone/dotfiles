export EDITOR='nvim'
export SUDO_EDITOR="$EDITOR"
command -v bat &>/dev/null && export BAT_THEME=ansi
export PATH="$HOME/.local/share/supabase:$PATH"
export PATH="$HOME/.local/bin:$PATH"
[[ "$(uname)" == "Darwin" ]] && PATH="$PATH:/Applications/WezTerm.app/Contents/MacOS"
[[ "$(uname)" == "Darwin" ]] && PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"

# WSL: /etc/wsl.conf sets appendWindowsPath=false to keep PATH off the 9p
# filesystem. Re-add only the two Windows dirs that are actually needed.
# Globbed rather than hardcoded so no work username lands in a public repo.
if [[ -n "$WSL_DISTRO_NAME" ]]; then
  # typeset -U keeps PATH de-duplicated: nested shells (tmux, subshells, the
  # VSCode integrated terminal) re-source this file and would otherwise stack
  # the same entries repeatedly.
  typeset -U path PATH
  # The Windows interop tools worth keeping: cmd/clip/wsl/reg (System32),
  # explorer.exe (C:\Windows), powershell.exe (its own subdir). Four entries
  # instead of the ~24 appendWindowsPath used to inject.
  for _d in "/mnt/c/Windows/System32" "/mnt/c/Windows" \
            "/mnt/c/Windows/System32/WindowsPowerShell/v1.0"; do
    [[ -d "$_d" ]] && path+=("$_d")
  done
  for _d in /mnt/c/Users/*/AppData/Local/Programs/Microsoft\ VS\ Code/bin(N); do
    path+=("$_d")
  done
  unset _d
  # win32yank.exe — nvim clipboard provider under WSL
  [[ -d "/mnt/c/Program Files/Neovim/bin" ]] && path+=("/mnt/c/Program Files/Neovim/bin")
fi

export PATH
