export EDITOR='nvim'
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi
export PATH="$HOME/.local/share/supabase:$PATH"
export PATH="$HOME/.local/bin:$PATH"
[[ "$(uname)" == "Darwin" ]] && PATH="$PATH:/Applications/WezTerm.app/Contents/MacOS"
[[ "$(uname)" == "Darwin" ]] && PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"
[[ "$(uname)" == "Darwin" ]] && PATH="/opt/homebrew/opt/llvm/bin:$PATH"
export PATH

# Rootless Docker keeps its socket in the user runtime dir; the CLI defaults to
# the system daemon's socket, which we no longer run.
[[ "$(uname)" == "Linux" ]] && export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$UID}/docker.sock"
